CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Clerk — get from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# CLERK_SECRET_KEY above is for your own reference only — Convex functions
# run in the cloud and don't read this file, so it must also be pushed to
# your Convex dev deployment: npx convex env set CLERK_SECRET_KEY <value>
