# Convex — get from https://dashboard.convex.dev
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Auth (@convex-dev/auth) — these run inside Convex functions, not this app,
# so they must be pushed to your Convex deployment, not just set here:
#   npx convex env set AUTH_GOOGLE_ID <value>
#   npx convex env set AUTH_GOOGLE_SECRET <value>
#   npx convex env set AUTH_RESEND_KEY <value>
# SITE_URL, JWT_PRIVATE_KEY, and JWKS are set automatically by
# `npx @convex-dev/auth` during setup.
