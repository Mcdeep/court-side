layout {
    tab name="CourtOS Dev" {
        pane split_direction="vertical" {
            pane {
                name "Convex"
                command "npx"
                args "convex" "dev"
                cwd "."
            }
            pane {
                name "Vite"
                command "npm"
                args "run" "dev"
                cwd "."
            }
        }
    }
}
